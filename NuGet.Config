<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- XAML-Math 3.0 mainline is built from its pinned source submodule. Keep the parent restore
       deterministic as well: clean CI runners must not depend on machine-global source mappings. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="dotnet-eng" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-eng/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-eng">
      <package pattern="Microsoft.DotNet.GenAPI" />
    </packageSource>
  </packageSourceMapping>
</configuration>
