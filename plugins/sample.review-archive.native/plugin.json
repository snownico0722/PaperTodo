{
  "kind": "native",
  "id": "sample.review-archive.native",
  "name": "Todo Review Archive",
  "description": "Tracks todo lifecycle, reminder changes, and completion trends, keeps a long-lived archive, and exports Excel-friendly CSV.",
  "version": "1.2.0",
  "apiVersion": "2.1",
  "stateVersion": 1,
  "entry": "PaperTodo.Plugin.ReviewArchive.dll",
  "capabilities": [
    "textZoom",
    "runtime"
  ],
  "permissions": [
    "papers.read",
    "papers.observe",
    "todos.read",
    "todos.observe"
  ],
  "settingCategories": [
    {
      "name": "Recording",
      "column": "left"
    },
    {
      "name": "Export",
      "column": "left"
    },
    {
      "name": "Display",
      "column": "right"
    }
  ],
  "settings": [
    {
      "id": "keepDeleted",
      "type": "boolean",
      "name": "Keep deleted sources",
      "description": "Keep review records after the original todo or entire todo paper is deleted.",
      "default": true,
      "category": "Recording"
    },
    {
      "id": "showOpenItems",
      "type": "boolean",
      "name": "Show open todos",
      "description": "Show unfinished items in the All records and Open filters.",
      "default": false,
      "category": "Display"
    },
    {
      "id": "showInsights",
      "type": "boolean",
      "name": "Show review metrics",
      "description": "Show today, last 7 days, completion streak, and open-count metrics.",
      "default": true,
      "category": "Display"
    },
    {
      "id": "trackCreated",
      "type": "boolean",
      "name": "Record creation time",
      "description": "Store the exact creation time for newly created todos.",
      "default": true,
      "category": "Recording"
    },
    {
      "id": "showReminderChanges",
      "type": "boolean",
      "name": "Show reminder changes",
      "description": "Record and show reminder creation, removal, and adjustment counts.",
      "default": true,
      "category": "Recording"
    },
    {
      "id": "highlightUpcomingReminders",
      "type": "boolean",
      "name": "Highlight upcoming reminders",
      "description": "Highlight reminders due within 24 hours or already overdue.",
      "default": true,
      "category": "Display"
    },
    {
      "id": "initialImport",
      "type": "select",
      "name": "Initial import of existing todos",
      "default": "completed",
      "options": [
        {
          "value": "none",
          "name": "Do not import automatically"
        },
        {
          "value": "completed",
          "name": "Completed only"
        },
        {
          "value": "all",
          "name": "All todos"
        }
      ],
      "category": "Recording"
    },
    {
      "id": "defaultFilter",
      "type": "select",
      "name": "Default filter",
      "default": "completed",
      "options": [
        {
          "value": "completed",
          "name": "Completed"
        },
        {
          "value": "today",
          "name": "Completed today"
        },
        {
          "value": "week",
          "name": "Last 7 days"
        },
        {
          "value": "month",
          "name": "Last 30 days"
        },
        {
          "value": "open",
          "name": "Open"
        },
        {
          "value": "reopened",
          "name": "Reopened"
        },
        {
          "value": "reminders",
          "name": "Has reminder"
        },
        {
          "value": "deleted",
          "name": "Source deleted"
        },
        {
          "value": "all",
          "name": "All records"
        }
      ],
      "category": "Display"
    },
    {
      "id": "retentionDays",
      "type": "number",
      "name": "Retention days",
      "description": "0 keeps records forever.",
      "default": 0,
      "min": 0,
      "max": 3650,
      "step": 30,
      "suffix": "days",
      "category": "Recording"
    },
    {
      "id": "maxRecords",
      "type": "number",
      "name": "Maximum records",
      "default": 10000,
      "min": 100,
      "max": 50000,
      "step": 100,
      "suffix": "records",
      "category": "Recording"
    },
    {
      "id": "exportEncoding",
      "type": "select",
      "name": "CSV encoding",
      "default": "utf8bom",
      "options": [
        {
          "value": "utf8bom",
          "name": "UTF-8 BOM (recommended for Excel)"
        },
        {
          "value": "utf8",
          "name": "UTF-8"
        }
      ],
      "category": "Export"
    },
    {
      "id": "exportDateFormat",
      "type": "select",
      "name": "Time format",
      "default": "local",
      "options": [
        {
          "value": "local",
          "name": "Local time (minutes)"
        },
        {
          "value": "iso",
          "name": "ISO style (seconds)"
        }
      ],
      "category": "Export"
    },
    {
      "id": "includePaperTitle",
      "type": "boolean",
      "name": "Include paper title",
      "default": true,
      "category": "Export"
    },
    {
      "id": "showDeletedBadge",
      "type": "boolean",
      "name": "Mark deleted sources",
      "default": true,
      "category": "Display"
    },
    {
      "id": "confirmClear",
      "type": "boolean",
      "name": "Confirm before clearing",
      "default": true,
      "category": "Export"
    },
    {
      "id": "titleMode",
      "type": "select",
      "name": "Capsule title",
      "default": "summary",
      "options": [
        {
          "value": "summary",
          "name": "Completed items"
        },
        {
          "value": "today",
          "name": "Today’s completed count"
        },
        {
          "value": "streak",
          "name": "Completion streak"
        },
        {
          "value": "open",
          "name": "Open count"
        },
        {
          "value": "fixed",
          "name": "Fixed text"
        }
      ],
      "category": "Display"
    },
    {
      "id": "fixedTitle",
      "type": "string",
      "name": "Fixed title",
      "default": "",
      "maxLength": 40,
      "placeholder": "Review Archive",
      "category": "Display"
    }
  ],
  "advancedSettings": true,
  "locales": {
    "zh": {
      "name": "待办复盘记录池",
      "description": "实时记录待办生命周期、提醒变化和完成趋势，长期保存并导出 Excel 可直接打开的 CSV。",
      "settingCategories": {
        "Recording": "记录",
        "Export": "导出",
        "Display": "显示"
      },
      "settings": {
        "keepDeleted": {
          "name": "保留已删除来源",
          "description": "删除原待办或整张待办纸后仍保留复盘记录。"
        },
        "showOpenItems": {
          "name": "显示进行中待办",
          "description": "在“全部记录”和“进行中”筛选中显示尚未完成的项目。"
        },
        "showInsights": {
          "name": "显示复盘指标",
          "description": "显示今日、近 7 天、连续完成日和进行中数量。"
        },
        "trackCreated": {
          "name": "记录创建时间",
          "description": "为新建待办保存精确创建时刻。"
        },
        "showReminderChanges": {
          "name": "显示提醒变化",
          "description": "记录并显示提醒设置、取消和调整次数。"
        },
        "highlightUpcomingReminders": {
          "name": "高亮近期提醒",
          "description": "高亮未来 24 小时内和已经到期的待办提醒。"
        },
        "initialImport": {
          "name": "首次导入现有待办",
          "options": {
            "none": "不自动导入",
            "completed": "仅已完成",
            "all": "全部待办"
          }
        },
        "defaultFilter": {
          "name": "默认筛选",
          "options": {
            "completed": "已完成",
            "today": "今天完成",
            "week": "近 7 天",
            "month": "近 30 天",
            "open": "进行中",
            "reopened": "重新打开",
            "reminders": "有提醒",
            "deleted": "源已删除",
            "all": "全部记录"
          }
        },
        "retentionDays": {
          "name": "保留天数",
          "description": "0 表示永久保留。",
          "suffix": "天"
        },
        "maxRecords": {
          "name": "最大记录数",
          "suffix": "条"
        },
        "exportEncoding": {
          "name": "CSV 编码",
          "options": {
            "utf8bom": "UTF-8 BOM（推荐 Excel）",
            "utf8": "UTF-8"
          }
        },
        "exportDateFormat": {
          "name": "时间格式",
          "options": {
            "local": "本地时间（到分钟）",
            "iso": "ISO 风格（到秒）"
          }
        },
        "includePaperTitle": {
          "name": "包含所属纸片"
        },
        "showDeletedBadge": {
          "name": "标记来源已删除"
        },
        "confirmClear": {
          "name": "清空前确认"
        },
        "titleMode": {
          "name": "胶囊标题",
          "options": {
            "summary": "累计完成项目",
            "today": "今日完成数",
            "streak": "连续完成日",
            "open": "进行中数量",
            "fixed": "固定文字"
          }
        },
        "fixedTitle": {
          "name": "固定标题",
          "placeholder": "复盘记录"
        }
      }
    }
  }
}
