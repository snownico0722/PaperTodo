<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- .NET 9+ publishes can opt into CET User Shadow Stack compatibility. Some legacy Windows
         environments fail before managed startup when the flag is present, so keep it disabled. -->
    <CETCompat>false</CETCompat>
    <!-- Declare AvalonEdit's WinForms cursor dependency explicitly. Framework-dependent publishes
         still load it from the installed Microsoft.WindowsDesktop.App shared framework. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF keeps DPI policy in app.manifest (PerMonitorV2); ignore WinForms-only WFO0003. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>3.31</Version>
    <AssemblyVersion>3.31.0.0</AssemblyVersion>
    <FileVersion>3.31.0.0</FileVersion>
    <InformationalVersion>3.31</InformationalVersion>
    <!-- Keep tray header "PaperTodo v3.31" free of +commit suffixes from SourceLink. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>assets\icons\PaperTodo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PaperTodoLmdbLibrary>$(MSBuildProjectDirectory)\native\lmdb\bin\win-x64\papertodo_lmdb.dll</PaperTodoLmdbLibrary>
    <OutputPath>$(MSBuildProjectDirectory)\输出\PaperTodo-v$(Version)\</OutputPath>
    <SatelliteResourceLanguages>en;ja;ko</SatelliteResourceLanguages>
    <DefaultItemExcludes>$(DefaultItemExcludes);对比_StickyMD\**;输出\**;PaperTodo_v*\**;.codex_decompile_debug\**;vendor\**</DefaultItemExcludes>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Store/MSIX builds opt into Windows SDK WinRT projections for StartupTask without changing
       the target framework or Win7 best-effort behavior of the normal portable 3.x build. -->
  <PropertyGroup Condition="'$(PaperTodoStoreBuild)' == 'true'">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DefineConstants>$(DefineConstants);PAPERTODO_STORE_BUILD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PaperTodoDefaultEnglish)' == 'true'">
    <DefineConstants>$(DefineConstants);PAPERTODO_DEFAULT_ENGLISH</DefineConstants>
  </PropertyGroup>

  <!-- Keep the legacy compatibility shim out of normal 3.x assemblies. The Win7 staged build
       opts it back in explicitly with PaperTodoWin7BestEffort=true. -->
  <ItemGroup>
    <Compile Remove="win7.fork\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(PaperTodoWin7BestEffort)' == 'true'">
    <Compile Include="win7.fork\Win7Compatibility.cs" />
  </ItemGroup>

  <!-- Microsoft Store flavor intentionally contains no telemetry implementation/resources.
       AppState keeps its legacy telemetryEnabled field only for data-file compatibility. -->
  <ItemGroup Condition="'$(PaperTodoStoreBuild)' == 'true'">
    <Compile Remove="src\TelemetryService.cs" />
    <Compile Remove="src\TelemetryCrashMarkerMigration.cs" />
    <Compile Remove="src\TelemetryStrings.cs" />
    <EmbeddedResource Remove="Resources\TelemetryStrings*.resx" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\icons\PaperTodo.ico" />
    <Content Include="$(PaperTodoLmdbLibrary)">
      <Link>papertodo_lmdb.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="vendor\wpf-notifyicon\src\NotifyIconWpf\NotifyIconWpf.csproj" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>
  <!-- WinForms pulls System.Drawing into global usings; keep WPF type names unambiguous. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <Target Name="EnsurePaperTodoLmdbLibrary" BeforeTargets="PrepareForBuild">
    <Error
      Condition="!Exists('$(PaperTodoLmdbLibrary)')"
      Text="PaperTodo's native LMDB library is missing. Restore native\lmdb\bin\win-x64\papertodo_lmdb.dll or build it with native\lmdb\build.ps1." />
  </Target>
</Project>
