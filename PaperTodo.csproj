<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WebView2CompositionControl uses WinRT projections supplied by a versioned Windows TFM. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Declare AvalonEdit's WinForms cursor dependency explicitly. Framework-dependent publishes
         still load it from the installed Microsoft.WindowsDesktop.App shared framework. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF keeps DPI policy in app.manifest (PerMonitorV2); ignore WinForms-only WFO0003. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- .NET 9+ marks Windows apphost/single-file hosts CET-compatible by default. Disable that
         opt-in for PaperTodo to avoid User Shadow Stack startup failures on affected legacy Windows builds. -->
    <CETCompat>false</CETCompat>
    <Version>4.0.0-beta1</Version>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <InformationalVersion>4.0.0-beta1</InformationalVersion>
    <!-- Keep tray header "PaperTodo v4.0.0-beta1" free of +commit suffixes from SourceLink. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>assets\PaperTodo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PaperTodoLmdbLibrary>$(MSBuildProjectDirectory)\native\lmdb\bin\win-x64\papertodo_lmdb.dll</PaperTodoLmdbLibrary>
    <PaperTodoMathLibrary>$(MSBuildProjectDirectory)\native\math\bin\win-x64\papertodo_math.dll</PaperTodoMathLibrary>
    <OutputPath>$(MSBuildProjectDirectory)\输出\PaperTodo-v$(Version)\</OutputPath>
    <SatelliteResourceLanguages>en;ja;ko</SatelliteResourceLanguages>
    <DefaultItemExcludes>$(DefaultItemExcludes);对比_StickyMD\**;输出\**;PaperTodo_v*\**;.codex_decompile_debug\**;PaperTodo.Plugin.Abstractions\**;plugin-samples\**;plugins\**\.runtime\**;plugins\data\**;tests\**;tools\**;vendor\**</DefaultItemExcludes>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PaperTodoDefaultEnglish)' == 'true'">
    <DefineConstants>$(DefineConstants);PAPERTODO_DEFAULT_ENGLISH</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Compress the WinRT projection in ordinary builds and no-runtime packages.
         Self-contained packages use the SDK's built-in bundle compression instead. -->
    <PaperTodoCompressWindowsSdk Condition="'$(PaperTodoCompressWindowsSdk)' == ''">true</PaperTodoCompressWindowsSdk>
    <_PaperTodoSdkCompressionEnabled>false</_PaperTodoSdkCompressionEnabled>
    <_PaperTodoSdkCompressionEnabled Condition="'$(PaperTodoCompressWindowsSdk)' == 'true' And '$(SelfContained)' != 'true' And '$(DisableFody)' != 'true'">true</_PaperTodoSdkCompressionEnabled>
    <DisableFody Condition="'$(_PaperTodoSdkCompressionEnabled)' != 'true'">true</DisableFody>
    <!-- Fody rewrites the intermediate assembly and caches which references it removed.
         Keep both modes separate so switching publish options never reuses a woven assembly/cache. -->
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\sdk-compression-$(_PaperTodoSdkCompressionEnabled)\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PaperTodo.DesktopBenchmarks</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PaperTodo.MaterialBenchmarks</_Parameter1>
    </AssemblyAttribute>
    <!-- Diagnostic entry points keep their existing DEBUG guards / Release no-op behavior.
         Their implementations belong to tools, not to the product source directory. -->
    <Compile Include="tools\PaperTodo.EdgeDiagnostics\EntryPoints\*.cs" Link="Diagnostics\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Real-process diagnostics are tooling, never a dependency on a test assembly. -->
    <Compile Include="tools\PaperTodo.EdgeDiagnostics\*.cs" Link="Diagnostics\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets\PaperTodo.ico" />
    <!-- Repository plugin outputs are available to normal development builds, but plugins are
         distributed separately and must not be included in local or CI publish artifacts. -->
    <Content Include="plugins\**\*" Exclude="plugins\**\.runtime\**;plugins\data\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Include="$(PaperTodoLmdbLibrary)">
      <Link>papertodo_lmdb.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Keep formula runtime assets inside the PaperTodo assembly so both current single-file
         release flavors remain genuinely single-file. MarkdownMathRenderer extracts content-hashed
         temporary copies only when Windows/WPF needs a filesystem path for DLL/font loading. -->
    <EmbeddedResource Include="$(PaperTodoMathLibrary)" LogicalName="PaperTodo.Native.papertodo_math.dll" />
    <EmbeddedResource Include="assets\math-fonts\*.ttf">
      <LogicalName>PaperTodo.MathFonts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="PaperTodo.Plugin.Abstractions\PaperTodo.Plugin.Abstractions.csproj" />
    <ProjectReference Include="vendor\wpf-notifyicon\src\NotifyIconWpf\NotifyIconWpf.csproj" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <!-- Markdig is the semantic parser only; AvalonEdit remains the source document and renderer. -->
    <PackageReference Include="Markdig" Version="1.3.2" />
    <!-- Keep restore inputs independent of publish options, including publishing without restoring. -->
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <!-- DirectComposition wraps live layered WPF capsule HWNDs without per-frame pixel copies or
         the Windows App SDK runtime. Opening captures one compact shell; the queue proxy is
         transient and falls back to the normal HWND path when a surface cannot be created. -->
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>
  <!-- WinForms pulls System.Drawing into global usings; keep WPF type names unambiguous. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <Target Name="EnsurePaperTodoLmdbLibrary" BeforeTargets="PrepareForBuild">
    <Error
      Condition="!Exists('$(PaperTodoLmdbLibrary)')"
      Text="PaperTodo's native LMDB library is missing. Restore native\lmdb\bin\win-x64\papertodo_lmdb.dll or build it with native\lmdb\build.ps1." />
  </Target>
  <Target Name="EnsurePaperTodoMathLibrary" BeforeTargets="PrepareForBuild">
    <Error
      Condition="!Exists('$(PaperTodoMathLibrary)')"
      Text="PaperTodo's native math library is missing. Restore native\math\bin\win-x64\papertodo_math.dll or build it with native\math\build.ps1." />
  </Target>
</Project>
