<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WebView2CompositionControl uses WinRT projections supplied by a versioned Windows TFM. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Declare AvalonEdit's WinForms cursor dependency explicitly. Framework-dependent publishes
         still load it from the installed Microsoft.WindowsDesktop.App shared framework. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF keeps DPI policy in app.manifest (PerMonitorV2); ignore WinForms-only WFO0003. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- .NET 9+ marks Windows apphost/single-file hosts CET-compatible by default. Disable that
         opt-in for PaperTodo to avoid User Shadow Stack startup failures on affected legacy Windows builds. -->
    <CETCompat>false</CETCompat>
    <Version>4.0.0-preview</Version>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <InformationalVersion>4.0Preview</InformationalVersion>
    <!-- Keep tray header "PaperTodo v4.0Preview" free of +commit suffixes from SourceLink. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- All restores, including ordinary `dotnet build`, must use the repository source mapping.
         This is required by the pinned XAML-Math source project and keeps clean CI/dev machines deterministic. -->
    <RestoreConfigFile>$(MSBuildProjectDirectory)\NuGet.Config</RestoreConfigFile>
    <ApplicationIcon>assets\PaperTodo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PaperTodoLmdbLibrary>$(MSBuildProjectDirectory)\native\lmdb\bin\win-x64\papertodo_lmdb.dll</PaperTodoLmdbLibrary>
    <OutputPath>$(MSBuildProjectDirectory)\输出\PaperTodo-v$(Version)\</OutputPath>
    <SatelliteResourceLanguages>en;ja;ko</SatelliteResourceLanguages>
    <DefaultItemExcludes>$(DefaultItemExcludes);对比_StickyMD\**;输出\**;PaperTodo_v*\**;.codex_decompile_debug\**;PaperTodo.Plugin.Abstractions\**;plugin-samples\**;plugins\**\.runtime\**;plugins\data\**;tests\**;vendor\**</DefaultItemExcludes>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PaperTodoDefaultEnglish)' == 'true'">
    <DefineConstants>$(DefineConstants);PAPERTODO_DEFAULT_ENGLISH</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets\PaperTodo.ico" />
    <!-- Repository plugin outputs are available to normal development builds, but plugins are
         distributed separately and must not be included in local or CI publish artifacts. -->
    <Content Include="plugins\**\*" Exclude="plugins\**\.runtime\**;plugins\data\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Include="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(PaperTodoLmdbLibrary)">
      <Link>papertodo_lmdb.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="PaperTodo.Plugin.Abstractions\PaperTodo.Plugin.Abstractions.csproj" />
    <ProjectReference Include="vendor\wpf-notifyicon\src\NotifyIconWpf\NotifyIconWpf.csproj" />
    <!-- XAML-Math 3.0 development mainline. vendor/xaml-math is a gitlink pinned to
         ForNeVeR/xaml-math commit e8b3681b7aac0902c14c6a80a009be847623fbbc. -->
    <ProjectReference Include="vendor\xaml-math\src\WpfMath\WpfMath.csproj" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <!-- Markdig owns ordinary Markdown grammar; AvalonEdit remains the only source document. -->
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="ModelContextProtocol" Version="2.0.0" />
    <!-- DirectComposition wraps live layered WPF capsule HWNDs without per-frame pixel copies or
         the Windows App SDK runtime. Opening captures one compact shell; the queue proxy is
         transient and falls back to the normal HWND path when a surface cannot be created. -->
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>
  <!-- WinForms pulls System.Drawing into global usings; keep WPF type names unambiguous. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <Target Name="EnsurePaperTodoLmdbLibrary" BeforeTargets="PrepareForBuild">
    <Error
      Condition="!Exists('$(PaperTodoLmdbLibrary)')"
      Text="PaperTodo's native LMDB library is missing. Restore native\lmdb\bin\win-x64\papertodo_lmdb.dll or build it with native\lmdb\build.ps1." />
  </Target>
</Project>
