<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(InjectionSystemChecks)' == 'true'">
    <StartupObject>InjectionSystemRunner</StartupObject>
  </PropertyGroup>
  <ItemGroup Condition="'$(InjectionSystemChecks)' != 'true'">
    <Compile Remove="InjectionSystem*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(InjectionSystemChecks)' == 'true'">
    <ProjectReference Include="../../plugin-samples/PaperTodo.Plugin.GoodLock/PaperTodo.Plugin.GoodLock.csproj" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../../PaperTodo.csproj" />
    <ProjectReference Include="../../plugin-samples/PaperTodo.Plugin.ReviewArchive/PaperTodo.Plugin.ReviewArchive.csproj" /></ItemGroup>
  <ItemGroup><None Update="bridge-check.cjs" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
