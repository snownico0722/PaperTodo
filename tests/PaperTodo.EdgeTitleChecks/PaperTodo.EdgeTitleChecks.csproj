<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>../../app.manifest</ApplicationManifest>
    <!-- R1 focused A/B swaps only this executable entry point; the normal EdgeTitle checks stay unchanged. -->
    <StartupObject Condition="'$(Pr260MovingHandoffHarness)' != 'true'">Program</StartupObject>
    <StartupObject Condition="'$(Pr260MovingHandoffHarness)' == 'true'">Pr260MovingHandoffProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../PaperTodo.csproj" /></ItemGroup>
</Project>