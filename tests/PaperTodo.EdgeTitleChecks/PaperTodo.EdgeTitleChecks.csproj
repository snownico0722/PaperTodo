<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>../../app.manifest</ApplicationManifest>
    <!-- Focused A/B harnesses swap only this entry point and leave the normal EdgeTitle entry point intact. -->
    <StartupObject Condition="'$(Pr260MovingHandoffHarness)' != 'true' and '$(Pr260CallbackLifetimeHarness)' != 'true'">Program</StartupObject>
    <StartupObject Condition="'$(Pr260MovingHandoffHarness)' == 'true'">Pr260MovingHandoffProgram</StartupObject>
    <StartupObject Condition="'$(Pr260CallbackLifetimeHarness)' == 'true'">Pr260StartupCallbackLifetimeProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../PaperTodo.csproj" /></ItemGroup>
</Project>