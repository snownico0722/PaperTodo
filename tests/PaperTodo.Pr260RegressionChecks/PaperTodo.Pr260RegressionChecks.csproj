<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CoordinatorSource Condition="'$(CoordinatorSource)' == ''">../../src/EdgePrewarmCoordinator.cs</CoordinatorSource>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Compile Include="Program.cs" />
    <!-- Execute the actual production scheduler; only optional diagnostic logging is stubbed. -->
    <Compile Include="$(CoordinatorSource)" Link="EdgePrewarmCoordinator.cs" />
  </ItemGroup>
</Project>
