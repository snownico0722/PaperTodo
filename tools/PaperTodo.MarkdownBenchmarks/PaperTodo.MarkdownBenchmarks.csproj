<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <Compile Include="../../src/MarkdownSemanticDocument.cs" Link="Product/MarkdownSemanticDocument.cs" />
    <Compile Include="../../src/MarkdownSemanticSnapshot*.cs" Link="Product/%(Filename)%(Extension)" />
    <Compile Include="../../src/MarkdownFencedCodeScanner.cs" Link="Product/MarkdownFencedCodeScanner.cs" />
    <Compile Include="../../src/MarkdownContainerPrefix.cs" Link="Product/MarkdownContainerPrefix.cs" />
    <Compile Include="../../src/MarkdownQuoteMarkers.cs" Link="Product/MarkdownQuoteMarkers.cs" />
  </ItemGroup>
</Project>
