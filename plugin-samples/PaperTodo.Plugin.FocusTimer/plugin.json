{
  "kind": "native",
  "id": "sample.focus-timer.native",
  "name": "专注计时器",
  "description": "可关联 PaperTodo 待办的 WPF 番茄钟，支持完成联动、自动选择下一项和折叠后台计时。",
  "version": "1.4.0",
  "apiVersion": "2.0",
  "stateVersion": 3,
  "entry": "PaperTodo.Plugin.FocusTimer.dll",
  "capabilities": [
    "textZoom"
  ],
  "permissions": [
    "papers.read",
    "papers.observe",
    "todos.read",
    "todos.observe",
    "todos.update"
  ],
  "settingCategories": [
    {
      "name": "联动",
      "column": "left"
    },
    {
      "name": "显示",
      "column": "left"
    },
    {
      "name": "计时",
      "column": "right"
    }
  ],
  "settings": [
    {
      "id": "autoStartNext",
      "type": "boolean",
      "name": "自动开始下一阶段",
      "description": "专注结束后自动开始休息，休息结束后自动开始专注。",
      "default": false,
      "category": "联动"
    },
    {
      "id": "showLinkedTodo",
      "type": "boolean",
      "name": "显示关联待办",
      "description": "在计时器中显示可实时同步的 PaperTodo 待办选择器。",
      "default": true,
      "category": "联动"
    },
    {
      "id": "completeLinkedTodo",
      "type": "boolean",
      "name": "专注结束后完成待办",
      "description": "完整完成一轮专注时，将当前关联待办标记为完成；跳过不触发。",
      "default": false,
      "category": "联动"
    },
    {
      "id": "autoSelectNextTodo",
      "type": "boolean",
      "name": "完成后选择下一项",
      "description": "自动完成关联待办后，按纸片和顺序选择下一条未完成待办。",
      "default": false,
      "category": "联动"
    },
    {
      "id": "showProgress",
      "type": "boolean",
      "name": "显示进度条",
      "default": true,
      "category": "显示"
    },
    {
      "id": "showCompleted",
      "type": "boolean",
      "name": "显示完成统计",
      "default": true,
      "category": "显示"
    },
    {
      "id": "focusMinutes",
      "type": "number",
      "name": "默认专注时长",
      "default": 25,
      "min": 1,
      "max": 180,
      "step": 1,
      "suffix": "分钟",
      "category": "计时"
    },
    {
      "id": "breakMinutes",
      "type": "number",
      "name": "默认休息时长",
      "default": 5,
      "min": 1,
      "max": 180,
      "step": 1,
      "suffix": "分钟",
      "category": "计时"
    },
    {
      "id": "adjustStep",
      "type": "number",
      "name": "加减步长",
      "default": 5,
      "min": 1,
      "max": 30,
      "step": 1,
      "suffix": "分钟",
      "category": "计时"
    },
    {
      "id": "dailyGoal",
      "type": "number",
      "name": "每日目标",
      "description": "0 表示只显示完成数，不显示目标。",
      "default": 4,
      "min": 0,
      "max": 24,
      "step": 1,
      "suffix": "轮",
      "category": "计时"
    },
    {
      "id": "sound",
      "type": "select",
      "name": "结束提示音",
      "default": "asterisk",
      "options": [
        {
          "value": "none",
          "name": "静音"
        },
        {
          "value": "beep",
          "name": "蜂鸣"
        },
        {
          "value": "asterisk",
          "name": "提示"
        },
        {
          "value": "exclamation",
          "name": "警示"
        }
      ],
      "category": "计时"
    },
    {
      "id": "titleStyle",
      "type": "select",
      "name": "胶囊标题",
      "default": "task",
      "options": [
        {
          "value": "task",
          "name": "待办与倒计时"
        },
        {
          "value": "countdown",
          "name": "阶段与倒计时"
        },
        {
          "value": "status",
          "name": "仅阶段状态"
        },
        {
          "value": "fixed",
          "name": "固定标题"
        }
      ],
      "category": "显示"
    },
    {
      "id": "confirmReset",
      "type": "boolean",
      "name": "重置前确认",
      "default": true,
      "category": "计时"
    }
  ],
  "advancedSettings": true,
  "primarySettings": 2
}
