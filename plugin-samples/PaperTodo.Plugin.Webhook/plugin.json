{
  "kind": "native",
  "id": "sample.webhook.native",
  "name": "Webhook 事件转发",
  "description": "按事件类型将 PaperTodo 事件发送到指定 Webhook。",
  "version": "1.0.0",
  "apiVersion": "2.2",
  "stateVersion": 1,
  "entry": "PaperTodo.Plugin.Webhook.dll",
  "capabilities": ["runtime"],
  "permissions": ["papers.read", "todos.read", "notes.read"],
  "startupPaper": {
    "enabledSetting": "autoStart",
    "instanceKey": "main",
    "presentation": "hidden",
    "title": "Webhook"
  },
  "settings": [
    { "id": "autoStart", "type": "boolean", "name": "启动时运行", "description": "启动时创建或恢复隐藏纸片，以保持事件转发运行。", "default": true },
    { "id": "routes", "type": "string", "name": "事件路由", "description": "JSON 对象：事件名称对应 HTTP(S) 地址；未列出的事件不发送。示例见插件说明。", "default": "{}", "maxLength": 16000 }
  ]
}
